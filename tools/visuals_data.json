   "id": "si-eva-formula",
   "examId": "system-integration",
   "chapter": "进度控制与进度成本",
   "title": "挣值管理：偏差与指数",
   "archetype": "formula",
   "caption": "偏差是绝对差，指数是比值；CV/SV < 0 或 CPI/SPI < 1 都代表不利。",
   "tags": ["计算", "高频"],
   "formula": "CV = EV − AC　　CPI = EV / AC",
   "note": "SV = EV − PV，SPI = EV / PV。CV 或 SV 为负表示不利；CPI 或 SPI 小于 1 表示效率低于计划。",
   "terms": [
    {"symbol": "EV", "meaning": "已完工作的预算价值"},
    {"symbol": "AC", "meaning": "已完成工作的实际成本"},
    {"symbol": "PV", "meaning": "计划工作预算成本"},
    {"symbol": "CPI / SPI", "meaning": "成本 / 进度绩效指数"}
   ]
  },
